+export function revokeUserSessions(username: string, exceptSessionId?: string) {
+  const db = getDb();
+  if (!db) return;
+  if (exceptSessionId) {
+    db.prepare('DELETE FROM sessions WHERE username = ? AND id != ?').run(username, exceptSessionId);
