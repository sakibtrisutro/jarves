# JARVIS AI System — Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file to Git!

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Cloud AI Provider Configuration
# Supported providers: gemini | openai | groq | mock
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# API Keys (Provide at least one cloud provider key)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Storage & Memory Paths
DATA_DIR=data
DB_PATH=data/jarvis.db

# Daily Spending Safety Limits (USD)
DAILY_BUDGET_LIMIT=2.00
